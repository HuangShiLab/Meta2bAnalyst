# Meta2bAnalyst Environment Configuration
# Copy this file to .env and customize values

# Database
DATABASE_URL=sqlite:///./meta2bAnalyst.db

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# CORS (comma-separated for container, list for local)
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:80

# Application
DEBUG=false
ENVIRONMENT=development

# External LLM (optional - Agent interpretation enhancement)
# Legacy platform keys (sk-...): KIMI_BASE_URL=https://api.moonshot.cn/v1, KIMI_MODEL=moonshot-v1-8k
# Coding keys (sk-kimi-...):     KIMI_BASE_URL=https://api.kimi.com/coding/v1, KIMI_MODEL=kimi-for-coding
# KIMI_API_KEY=
# KIMI_BASE_URL=
# KIMI_MODEL=
