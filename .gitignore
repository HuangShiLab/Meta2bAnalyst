# Demo datasets: the sample_data/ negations live further below (they must
# come after `sample_data/*`); the frontend demo bar files only need to
# escape the `*.tsv` rule above.
!frontend/public/examples/demo/**
*.biom

# Temporary scripts (repo root only - do NOT ignore backend/tests/)
/add_*.py
/check_*.py
/fix_*.py
/run_*.py
/test_*.py
/build_test_payload.py
/generate_*.py
/expand_kb.py
/translate_ui.py
/start_backend.*

# Report outputs
report_images/
report_output/
# sample_data/: ignore its *contents* by default (never the directory
# itself, or negations cannot take effect), then re-include the four
# demo-dataset subdirectories — they are bundled into the backend image
# (docker/backend.Dockerfile COPY), used by scripts/pipeline_smoke.py and
# the MCP load_demo_dataset tool. Without these tracked, a fresh clone
# cannot build the image. The same files back the frontend demo bar.
# NOTE: these negations must come AFTER both `*.tsv` and `sample_data/*`.
sample_data/*
!/sample_data/microbiome/
!/sample_data/metabolome/
!/sample_data/multi-omics/
!/sample_data/multi-site-multi-omics/
!/sample_data/*/**

