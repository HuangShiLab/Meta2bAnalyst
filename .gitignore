# Worked-example datasets in sample_data/: bundled into the backend image
# (docker/backend.Dockerfile COPY) and used by scripts/pipeline_smoke.py.
# Without these tracked, a fresh clone cannot build the image.
!/sample_data/Huang_mBio_microbiome.tsv
!/sample_data/Huang_mBio_metabolome.tsv
!/sample_data/Huang_mBio_metadata.tsv
*.biom

# Temporary scripts (repo root only - do NOT ignore backend/tests/)
/add_*.py
/check_*.py
/fix_*.py
/run_*.py
/test_*.py
/build_test_payload.py
/generate_*.py
/expand_kb.py
/translate_ui.py
/start_backend.*

# Report outputs
report_images/
report_output/
# sample_data/ holds the tracked Huang_mBio worked examples (un-ignored
# above) plus regenerable local content — ignore its *contents* by default,
# never the directory itself, or the negations above cannot take effect
# (git cannot re-include files under an excluded directory).
sample_data/*

